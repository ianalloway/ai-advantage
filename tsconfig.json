{
    "files": [],
    "references": [
          { "path": "./tsconfig.app.json" },
          { "path": "./tsconfig.node.json" },
          { "path": "./tsconfig.server.json" }
    ],
    "compilerOptions": {
          "ignoreDeprecations": "5.0",
          "paths": {
                  "@/*": ["./src/*"]
          },
          "noImplicitAny": true,
          "noUnusedParameters": true,
          "skipLibCheck": true,
          "allowJs": true,
          "noUnusedLocals": true,
          "strictNullChecks": true
    }
}
