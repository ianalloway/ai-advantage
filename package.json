{
  "name": "ai-advantage",
  "private": true,
  "version": "0.0.0",
  "description": "Sports betting platform with ML predictions, Kelly Criterion bet sizing, live odds, and daily AI picks. NBA, NFL, MLB.",
  "author": "Ian Alloway <ian@allowayllc.com>",
  "license": "MIT",
  "homepage": "https://aiadvantagesports.com",
  "repository": {
    "type": "git",
